# Copie este arquivo para .env.local e preencha com os dados do SEU projeto Supabase
# (Supabase → Project Settings → API). Nunca coloque a chave secreta aqui com NEXT_PUBLIC_.
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_xxxxxxxx
# Endereço do site (usado nos links que vão pelo WhatsApp)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Chave de serviço do Supabase (só servidor: assinatura e avisos do Asaas)
SUPABASE_SERVICE_ROLE_KEY=
# Asaas (cobrança da mensalidade). ASAAS_AMBIENTE=producao para a conta real; vazio = sandbox
ASAAS_API_KEY=
ASAAS_WEBHOOK_TOKEN=
ASAAS_AMBIENTE=
